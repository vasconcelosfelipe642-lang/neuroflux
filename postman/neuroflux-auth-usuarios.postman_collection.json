{
  "info": {
    "_postman_id": "69f1819a-7ef9-4f0d-9c4c-neuroflux-auth",
    "name": "NeuroFlux - Auth e Usuarios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Health check",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const stamp = Date.now();",
              "pm.collectionVariables.set('commonEmail', 'gabriel.comum.' + stamp + '@email.com');",
              "pm.collectionVariables.unset('accessToken');",
              "pm.collectionVariables.unset('refreshToken');",
              "pm.collectionVariables.unset('userId');",
              "pm.collectionVariables.unset('taskId');",
              "pm.collectionVariables.unset('subtaskId');"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('API esta online', () => {",
              "  pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ""
          ]
        }
      }
    },
    {
      "name": "02 - Bloquear cadastro publico como admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Nao permite criar admin pelo cadastro publico', () => {",
              "  pm.response.to.have.status(400);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Retorna mensagem de erro', () => {",
              "  pm.expect(json.error).to.be.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Tentativa Admin\",\n  \"email\": \"tentativa.admin.{{$timestamp}}@email.com\",\n  \"senha\": \"123456\",\n  \"role\": \"admin\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "register"
          ]
        }
      }
    },
    {
      "name": "03 - Cadastrar usuario comum",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.collectionVariables.get('commonEmail')) {",
              "  const stamp = Date.now();",
              "  pm.collectionVariables.set('commonEmail', 'gabriel.comum.' + stamp + '@email.com');",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Cadastro retorna 201', () => {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Retorna par de tokens', () => {",
              "  pm.expect(json.accessToken).to.be.a('string');",
              "  pm.expect(json.refreshToken).to.be.a('string');",
              "});",
              "",
              "pm.test('Usuario cadastrado como common', () => {",
              "  pm.expect(json.user.role).to.eql('common');",
              "});",
              "",
              "pm.collectionVariables.set('accessToken', json.accessToken);",
              "pm.collectionVariables.set('refreshToken', json.refreshToken);",
              "pm.collectionVariables.set('userId', String(json.user.id));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Gabriel Comum\",\n  \"email\": \"{{commonEmail}}\",\n  \"senha\": \"123456\",\n  \"role\": \"common\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "register"
          ]
        }
      }
    },
    {
      "name": "04 - Login usuario comum",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login retorna 200', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Login retorna tokens e usuario', () => {",
              "  pm.expect(json.accessToken).to.be.a('string');",
              "  pm.expect(json.refreshToken).to.be.a('string');",
              "  pm.expect(json.user.id).to.exist;",
              "});",
              "",
              "pm.collectionVariables.set('accessToken', json.accessToken);",
              "pm.collectionVariables.set('refreshToken', json.refreshToken);",
              "pm.collectionVariables.set('userId', String(json.user.id));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{commonEmail}}\",\n  \"senha\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        }
      }
    },
    {
      "name": "05 - Usuario comum nao lista usuarios",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Usuario comum recebe 403', () => {",
              "  pm.response.to.have.status(403);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios"
          ]
        }
      }
    },
    {
      "name": "06 - Criar tarefa",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Tarefa criada', () => {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('taskId', String(json.id));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Testar refresh token no Postman\",\n  \"descricao\": \"Fluxo completo de auth e tarefas\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tarefas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas"
          ]
        }
      }
    },
    {
      "name": "07 - Criar subtarefa",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Subtarefa criada', () => {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('subtaskId', String(json.id));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Executar collection completa\",\n  \"tarefaId\": {{taskId}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/subtarefas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "subtarefas"
          ]
        }
      }
    },
    {
      "name": "08 - Listar tarefas",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Lista tarefas', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Retorna array', () => {",
              "  pm.expect(json).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tarefas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas"
          ]
        }
      }
    },
    {
      "name": "09 - Atualizar subtarefa",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Subtarefa atualizada', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Subtarefa concluida', () => {",
              "  pm.expect(json.concluida).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"concluida\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/subtarefas/{{subtaskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "subtarefas",
            "{{subtaskId}}"
          ]
        }
      }
    },
    {
      "name": "10 - Renovar access token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Refresh retorna 200', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Retorna novo par de tokens', () => {",
              "  pm.expect(json.accessToken).to.be.a('string');",
              "  pm.expect(json.refreshToken).to.be.a('string');",
              "});",
              "",
              "pm.collectionVariables.set('accessToken', json.accessToken);",
              "pm.collectionVariables.set('refreshToken', json.refreshToken);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/refresh-token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "refresh-token"
          ]
        }
      }
    },
    {
      "name": "11 - Usar novo access token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Novo access token funciona', () => {",
              "  pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tarefas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas"
          ]
        }
      }
    },
    {
      "name": "12 - Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Logout retorna 204', () => {",
              "  pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "logout"
          ]
        }
      }
    },
    {
      "name": "13 - Refresh apos logout deve falhar",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Refresh revogado retorna 401', () => {",
              "  pm.response.to.have.status(401);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/refresh-token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "refresh-token"
          ]
        }
      }
    },
    {
      "name": "Admin opcional - Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 401) {",
              "  console.warn('Admin opcional nao configurado. Crie/promova um admin no banco e ajuste adminEmail/adminPassword.');",
              "  return;",
              "}",
              "",
              "pm.test('Login admin retorna 200', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Usuario logado e admin', () => {",
              "  pm.expect(json.user.role).to.eql('admin');",
              "});",
              "",
              "pm.collectionVariables.set('adminAccessToken', json.accessToken);",
              "pm.collectionVariables.set('adminRefreshToken', json.refreshToken);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        }
      }
    },
    {
      "name": "Admin opcional - Listar usuarios",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (!pm.collectionVariables.get('adminAccessToken')) {",
              "  console.warn('Pulando validacao admin: token admin ausente.');",
              "  return;",
              "}",
              "",
              "pm.test('Admin lista usuarios', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Retorna array de usuarios', () => {",
              "  pm.expect(json).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios"
          ]
        }
      }
    }
